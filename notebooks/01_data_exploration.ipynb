import pandas as pd

# Load the dataset
df = pd.read_csv('../data/job_postings.csv')

# Drop the backend tracking columns we don't need for analysis
columns_to_drop = ['last_processed_time', 'last_status', 'got_summary', 'got_ner', 'is_being_worked']
df = df.drop(columns=columns_to_drop)

# Inspect the first few rows of our clean data
print(df.head())

# Check for any missing values
print(df.isnull().sum())
